                "type": "Expression"
              },
              "type": "string"
            },
            "pParquetFile": {
              "value": {
                "value": "@variables('FileName')",
                "type": "Expression"
              },
              "type": "string"
            },
            "pDeltaLakeFolder": {
              "value": {
                "value": "@variables('FolderPath')",
                "type": "Expression"
              },
              "type": "string"
            }
          }
        },
        "policy": {
          "timeout": "0.00:30:00",
          "retry": 0,
          "retryIntervalInSeconds": 30,
          "secureInput": false,
          "secureOutput": false
        },
        "name": "nb_BronzeKantataDeltaAppend",
        "dependsOn": [
          {
            "activity": "IngestSalesforce",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ]
      }
    ],
