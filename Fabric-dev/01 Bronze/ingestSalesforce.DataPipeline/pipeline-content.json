{
  "properties": {
    "activities": [
      {
        "type": "Copy",
        "typeProperties": {
          "source": {
            "type": "SalesforceServiceCloudSource",
            "query": {
              "value": "SELECT  @{pipeline().parameters.KantataSelectColumns}\nFROM    @{pipeline().parameters.ApiEndPoint}\nWHERE   @{pipeline().parameters.WatermarkColumnName} > @{formatDateTime(pipeline().parameters.CurrentWatermark,'yyyy-MM-ddTHH:mm:ssZ')}",
              "type": "Expression"
            },
            "additionalColumns": [
              {
                "name": "_crda_SourceExecutionDateTime",
                "value": {
                  "value": "@utcNow()",
                  "type": "Expression"
                }
              },
              {
                "name": "_crda_SourceFileName",
                "value": {
                  "value": "@concat(variables('FolderPath'),'/', variables('FileName'))",
                  "type": "Expression"
                }
              },
              {
                "name": "_crda_SourceExecutionId",
                "value": {
                  "value": "@string(pipeline().parameters.ExecutionId)",
                  "type": "Expression"
                }
              }
            ],
            "includeDeletedObjects": true,
            "partitionOption": "None",
            "datasetSettings": {
              "type": "SalesforceServiceCloudObject",
              "schema": [],
              "externalReferences": {
                "connection": "@pipeline().libraryVariables.vl_SrcSalesforceKantata_Salesforce_ConnectionId"
              },
              "annotations": []
            }
          },
          "sink": {
            "type": "ParquetSink",
            "formatSettings": {
              "type": "ParquetWriteSettings",
              "enableVertiParquet": true
            },
            "storeSettings": {
              "type": "LakehouseWriteSettings"
            },
            "datasetSettings": {
              "type": "Parquet",
              "typeProperties": {
                "location": {
                  "type": "LakehouseLocation",
                  "folderPath": {
                    "value": "@variables('FolderPath')",
                    "type": "Expression"
                  },
                  "fileName": {
                    "value": "@variables('FileName')",
                    "type": "Expression"
                  }
                },
                "compressionCodec": "snappy"
              },
              "schema": [],
              "linkedService": {
                "name": "lh_BronzeLayer",
                "properties": {
                  "type": "Lakehouse",
                  "typeProperties": {
                    "artifactId": "9e22841c-13b0-87c1-4fc4-f0acc6eb7c0f",
                    "workspaceId": "00000000-0000-0000-0000-000000000000",
                    "rootFolder": "Files"
                  },
                  "annotations": []
                }
              },
              "annotations": []
            }
          },
          "translator": {
            "type": "TabularTranslator",
            "typeConversion": true,
            "typeConversionSettings": {
              "allowDataTruncation": true,
              "treatBooleanAsNumber": false
            }
          },
          "enableStaging": false
        },
        "policy": {
          "timeout": "0.00:30:00",
          "retry": 5,
          "retryIntervalInSeconds": 30,
          "secureInput": false,
          "secureOutput": false
        },
        "name": "IngestSalesforce",
        "dependsOn": [
          {
            "activity": "SetFileName",
            "dependencyConditions": [
              "Succeeded"
            ]
          },
          {
            "activity": "SetFolderPath",
            "dependencyConditions": [
              "Succeeded"
            ]
          },
          {
            "activity": "Set TimeNow",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ]
      },
      {
        "type": "SetVariable",
        "typeProperties": {
          "variableName": "FileName",
          "value": {
            "value": "@concat(replace(replace(substring(utcnow(),8,11),':',''),'T','-'), '.parquet')",
            "type": "Expression"
          }
        },
        "policy": {
          "secureInput": false,
          "secureOutput": false
        },
        "name": "SetFileName",
        "dependsOn": []
      },
      {
        "type": "SetVariable",
        "typeProperties": {
          "variableName": "FolderPath",
          "value": {
            "value": "@{concat(pipeline().parameters.DeltaLakeSourceFolder,'/',\n    replace(substring(utcNow(),0,7),'-',\n    '/'))}",
            "type": "Expression"
          }
        },
        "policy": {
          "secureInput": false,
          "secureOutput": false
        },
        "name": "SetFolderPath",
        "dependsOn": []
      },
      {
        "type": "SetVariable",
        "typeProperties": {
          "variableName": "TimeNow",
          "value": {
            "value": "@formatDateTime(utcNow(),'yyyy-MM-dd HH:mm:ss')",
            "type": "Expression"
          }
        },
        "policy": {
          "secureInput": false,
          "secureOutput": false
        },
        "name": "Set TimeNow",
        "dependsOn": []
      },
      {
        "type": "Lookup",
        "typeProperties": {
          "source": {
            "type": "LakehouseTableSource",
            "sqlReaderQuery": {
              "value": "SELECT\n    [@{pipeline().parameters.WatermarkColumnName}] = \n    COALESCE(MAX(@{pipeline().parameters.WatermarkColumnName}), '@{pipeline().parameters.CurrentWatermark}' )\nFROM [lh_BronzeLayer].[@{pipeline().parameters.SchemaName}].[@{pipeline().parameters.TableName}]",
              "type": "Expression"
            },
            "queryTimeout": "00:02:00",
            "partitionOption": "None"
          },
          "datasetSettings": {
            "type": "LakehouseTable",
            "schema": [],
            "connectionSettings": {
              "name": "lh_BronzeLayer",
              "properties": {
                "type": "Lakehouse",
                "typeProperties": {
                  "artifactId": "9e22841c-13b0-87c1-4fc4-f0acc6eb7c0f",
                  "workspaceId": "00000000-0000-0000-0000-000000000000",
                  "rootFolder": "Tables"
                },
                "externalReferences": {
                  "connection": "1be520da-b501-45e2-94f4-548d7afc445a"
                },
                "annotations": []
              }
            },
            "annotations": []
          },
          "firstRowOnly": false
        },
        "policy": {
          "timeout": "0.00:10:00",
          "retry": 5,
          "retryIntervalInSeconds": 30,
          "secureInput": false,
          "secureOutput": false
        },
        "name": "ReadWatermark",
        "dependsOn": [
          {
            "activity": "nb_BronzeKantataDeltaAppend",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ]
      },
      {
        "type": "Lookup",
        "typeProperties": {
          "source": {
            "type": "CopySource"
          },
          "datasetSettings": {
            "type": "DatasetBase"
          }
        },
        "policy": {
          "timeout": "0.00:01:00",
          "retry": 5,
          "retryIntervalInSeconds": 30,
          "secureInput": false,
          "secureOutput": false
        },
        "name": "LogWatermark",
        "state": "Inactive",
        "onInactiveMarkAs": "Succeeded",
        "dependsOn": [
          {
            "activity": "ReadWatermark",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ]
      },
      {
        "type": "TridentNotebook",
        "typeProperties": {
          "notebookId": "bf761730-b30f-86ea-4261-7e8ff45bcfa7",
          "workspaceId": "00000000-0000-0000-0000-000000000000",
