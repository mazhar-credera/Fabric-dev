        "state": "Inactive",
        "onInactiveMarkAs": "Succeeded",
        "dependsOn": [
          {
            "activity": "SetFileName",
            "dependencyConditions": [
              "Succeeded"
            ]
          },
          {
            "activity": "SetFolderPath",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "policy": {
          "timeout": "0.01:00:00",
          "retry": 0,
          "retryIntervalInSeconds": 30,
          "secureOutput": false,
          "secureInput": false
        },
        "typeProperties": {
          "source": {
            "type": "RestSource",
            "additionalColumns": [
              {
                "name": "CompanyName",
                "value": {
                  "value": "@pipeline().parameters.CompanyName",
                  "type": "Expression"
                }
              },
              {
                "name": "CompanyId",
                "value": {
                  "value": "@pipeline().parameters.CompanyId",
                  "type": "Expression"
                }
              },
              {
                "name": "_crda_BronzeLoadDateTime",
                "value": {
                  "value": "@utcNow()",
                  "type": "Expression"
                }
              },
              {
                "name": "_crda_SourceFileName",
                "value": {
                  "value": "@concat(variables('FolderPath'),'/',variables('FileName'))",
                  "type": "Expression"
                }
              },
              {
                "name": "_crda_SourceExecutionId",
                "value": {
                  "value": "@pipeline().parameters._crda_SourceExecutionId",
                  "type": "Expression"
                }
