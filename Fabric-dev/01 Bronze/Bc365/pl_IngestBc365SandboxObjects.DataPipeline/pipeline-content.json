          "relativeUrl": {
            "value": "@{pipeline().libraryVariables.vl_Bc365_Bc365TenantId}/oauth2/v2.0/token",
            "type": "Expression"
          },
          "body": {
            "value": "@concat(\n    'grant_type=client_credentials'\n    ,'&scope=https://api.businesscentral.dynamics.com/.default'\n    ,'&client_id='\n    ,pipeline().libraryVariables.vl_Bc365_Bc365ClientId\n    ,'&client_secret='\n    ,encodeUriComponent(pipeline().libraryVariables.vl_Bc365_Bc365SandboxSec)\n)",
            "type": "Expression"
          }
        },
        "externalReferences": {
          "connection": "96e1e28e-089c-4fb4-998f-97fdd4f70d53"
        }
      },
      {
