      {
        "name": "SetFileName",
        "type": "SetVariable",
        "dependsOn": [
          {
            "activity": "Get Bc365 Token",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "policy": {
          "secureOutput": false,
          "secureInput": false
        },
        "typeProperties": {
          "variableName": "FileName",
          "value": {
            "value": "@concat(replace(replace(substring(utcnow(),8,11),':',''),'T','-'), '.parquet')",
            "type": "Expression"
          }
        }
      },
      {
        "name": "SetFolderPath",
        "type": "SetVariable",
        "dependsOn": [
          {
            "activity": "Get Bc365 Token",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "policy": {
          "secureOutput": false,
          "secureInput": false
        },
        "typeProperties": {
          "variableName": "FolderPath",
          "value": {
            "value": "@{concat(replace(pipeline().parameters.DeltaLakeSourceFolder,'{CompanyName}', pipeline().parameters.CompanyName),'/',replace(substring(utcNow(),0,7),'-','/'))}",
            "type": "Expression"
          }
        }
      },
      {
        "name": "Get BC_Data",
        "type": "WebActivity",
        "dependsOn": [
          {
