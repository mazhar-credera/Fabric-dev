      },
      "vl_Bc365_cnBc365CWebConnectionId": {
        "type": "String",
        "variableName": "cnBc365CWebConnectionId",
        "libraryName": "vl_Bc365"
      },
      "vl_Bc365_Bc365ProdSec": {
        "type": "String",
