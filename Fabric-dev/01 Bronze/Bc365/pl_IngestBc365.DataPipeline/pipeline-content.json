{
  "properties": {
    "activities": [
      {
        "name": "Get Bc365 Token",
        "type": "WebActivity",
        "dependsOn": [],
        "policy": {
          "timeout": "0.00:10:00",
          "retry": 0,
          "retryIntervalInSeconds": 30,
          "secureOutput": false,
          "secureInput": true
        },
        "typeProperties": {
          "method": "POST",
          "headers": {
            "Content-Type": "application/x-www-form-urlencoded"
          },
          "relativeUrl": {
            "value": "@{pipeline().libraryVariables.vl_SrcBc365_Bc365TenantId}/oauth2/v2.0/token",
            "type": "Expression"
          },
          "body": {
            "value": "@concat(\n    'grant_type=client_credentials'\n    ,'&scope=https://api.businesscentral.dynamics.com/.default'\n    ,'&client_id='\n    ,pipeline().libraryVariables.vl_Bc365_Bc365ClientId\n    ,'&client_secret='\n    ,encodeUriComponent(pipeline().libraryVariables.vl_Bc365_Bc365ProdSec)\n)",
            "type": "Expression"
          }
        },
        "externalReferences": {
          "connection": "96e1e28e-089c-4fb4-998f-97fdd4f70d53"
        }
      },
      {
        "name": "Get Companies",
        "type": "WebActivity",
        "dependsOn": [
          {
            "activity": "Get Bc365 Token",
            "dependencyConditions": [
              "Succeeded"
            ]
          },
          {
            "activity": "Get CompanyNames",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "policy": {
          "timeout": "0.00:30:00",
          "retry": 0,
          "retryIntervalInSeconds": 30,
          "secureOutput": false,
          "secureInput": true
        },
        "typeProperties": {
          "method": "GET",
          "headers": {
            "Authorization": {
              "value": "@concat('Bearer ', activity('Get Bc365 Token').output.access_token)",
              "type": "Expression"
            },
            "Accept": "application/json"
          },
          "relativeUrl": {
            "value": "/@{pipeline().libraryVariables.vl_SrcBc365_Bc365TenantId}/@{pipeline().libraryVariables.vl_Bc365_Bc365UkEnvSandbox}/api/v2.0/companies?$filter=@{activity('Get CompanyNames').output.firstRow.CompanyName}",
            "type": "Expression"
          }
        },
        "externalReferences": {
          "connection": "c9d52d7a-b4d6-46bb-8671-ecad64ab916e"
        }
      },
      {
        "name": "ForEachCompany",
        "type": "ForEach",
        "state": "Inactive",
        "onInactiveMarkAs": "Succeeded",
        "dependsOn": [
          {
            "activity": "Get Companies",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "typeProperties": {
          "items": {
            "value": "@activity('Get Companies').output.value",
            "type": "Expression"
          },
          "activities": [
            {
              "name": "pl_IngestBc365_GetCustomApiObjects",
              "type": "InvokePipeline",
              "dependsOn": [],
              "policy": {
                "timeout": "0.1:00:00",
                "retry": 0,
                "retryIntervalInSeconds": 30,
                "secureOutput": false,
                "secureInput": false
              },
              "typeProperties": {
                "waitOnCompletion": true,
                "operationType": "InvokeFabricPipeline",
                "pipelineId": "67743ace-b31b-4a04-b259-b57584c44f77",
                "workspaceId": "29f8113f-2a90-401e-a4f7-d6121b481419",
                "parameters": {
                  "CompanyName": {
                    "value": "@item().CompanyName",
                    "type": "Expression"
                  },
                  "ProcessPath": {
                    "value": "@pipeline().PipelineName",
                    "type": "Expression"
                  },
                  "CompanyId": {
                    "value": "@item().CompanyId",
                    "type": "Expression"
                  }
                }
              },
              "externalReferences": {
                "connection": "1a2c4c71-4ef2-4838-bd3a-2f14c381d214"
              }
            }
          ]
        }
      },
      {
        "name": "Get CompanyNames",
        "type": "Lookup",
        "dependsOn": [],
        "policy": {
          "timeout": "0.00:10:00",
          "retry": 0,
          "retryIntervalInSeconds": 30,
          "secureOutput": false,
          "secureInput": false
        },
        "typeProperties": {
          "source": {
            "type": "FabricSqlDatabaseSource",
            "sqlReaderQuery": {
              "value": "SELECT\n\tCompanyName = STRING_AGG(CONCAT('name eq ', CHAR(39), CompanyName, CHAR(39)),\n\t\t\t\t\t' or ')\nFROM\tETL.BcCompanyName \nWHERE\tIsEnabled = 1;\n",
              "type": "Expression"
            },
            "queryTimeout": "02:00:00",
            "partitionOption": "None"
          },
          "datasetSettings": {
            "annotations": [],
            "connectionSettings": {
              "name": "4d22d9c9_3601_4e62_93a5_fc093584d025",
              "properties": {
                "annotations": [],
                "type": "FabricSqlDatabase",
                "typeProperties": {
                  "workspaceId": "@pipeline().libraryVariables.vl_FabricObjects_WorkspaceId",
                  "artifactId": "@pipeline().libraryVariables.vl_FabricObjects_FabricDbId"
                },
                "externalReferences": {
                  "connection": "@pipeline().libraryVariables.vl_FabricObjects_cnFabricDbConnectionId"
                }
              }
            },
            "type": "FabricSqlDatabaseTable",
            "schema": [],
            "typeProperties": {}
          }
        }
      }
    ],
    "variables": {
      "LastRunDate": {
        "type": "String",
        "defaultValue": "2025-01-01T00:00:00Z"
      },
      "NextPageUrl": {
        "type": "String"
      }
    },
    "libraryVariables": {
      "vl_Bc365_Bc365TokenUri": {
