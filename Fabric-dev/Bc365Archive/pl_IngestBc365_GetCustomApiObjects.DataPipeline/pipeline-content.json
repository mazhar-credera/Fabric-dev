                  },
                  "CompanyName": {
                    "value": "@item().CompanyName",
                    "type": "Expression"
                  },
                  "StagingProjection": {
                    "value": "@concat(\n\t'BC_',\n\titem().CleanedCompanyName,\n\t'_',\n\titem().ApiEntitySetName\n)",
