                  "workspaceId": "@pipeline().libraryVariables.vl_FabricObjects_WorkspaceId"
                },
                "externalReferences": {
                  "connection": "@pipeline().libraryVariables.vl_FabricObjects_cnFabricDbConnectionId"
                },
                "annotations": []
              }
            },
            "annotations": []
          },
          "firstRowOnly": false
        },
        "policy": {
          "timeout": "0.00:10:00",
          "retry": 0,
          "retryIntervalInSeconds": 30,
          "secureInput": false,
          "secureOutput": false
        },
        "name": "Get ApiEndPoints",
        "dependsOn": []
      },
      {
        "type": "SetVariable",
