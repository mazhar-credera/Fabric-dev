            "sqlReaderQuery": {
              "value": "SELECT\tB.CompanyName, B.ApiGroup, B.ApiEntitySetName ,\n\t\tCleanedCompanyName = REPLACE(REPLACE(B.CompanyName, ' ', ''), '.', '')\nFROM\tETL.BcSourceConfig B\nWHERE\tB.IsEnabled = 1 \nAND \tB.CompanyName = '@{pipeline().parameters.CompanyName}'",
              "type": "Expression"
            },
            "partitionOption": "None",
            "queryTimeout": "02:00:00"
          },
          "datasetSettings": {
            "type": "FabricSqlDatabaseTable",
            "schema": [],
            "connectionSettings": {
              "name": "4d22d9c9_3601_4e62_93a5_fc093584d025",
