{
  "properties": {
    "activities": [
      {
        "name": "Get Bc365 Token",
        "type": "WebActivity",
        "dependsOn": [],
        "policy": {
          "timeout": "0.00:10:00",
          "retry": 0,
          "retryIntervalInSeconds": 30,
          "secureOutput": false,
          "secureInput": false
        },
        "typeProperties": {
          "method": "POST",
          "headers": {
            "Content-Type": "application/x-www-form-urlencoded"
          },
          "relativeUrl": {
            "value": "@{pipeline().libraryVariables.vl_Bc365_Bc365TenantId}/oauth2/v2.0/token",
            "type": "Expression"
          },
          "body": {
            "value": "@concat(\n    'grant_type=client_credentials'\n    ,'&scope=https://api.businesscentral.dynamics.com/.default'\n    ,'&client_id='\n    ,pipeline().libraryVariables.vl_Bc365_Bc365ClientIdSandbox\n    ,'&client_secret='\n    ,encodeUriComponent(pipeline().libraryVariables.vl_Bc365_Bc365SandboxSec)\n)",
            "type": "Expression"
          }
        },
        "externalReferences": {
          "connection": "96e1e28e-089c-4fb4-998f-97fdd4f70d53"
        }
      },
      {
        "name": "Get Bc365",
        "type": "WebActivity",
        "state": "Inactive",
        "onInactiveMarkAs": "Succeeded",
        "dependsOn": [
          {
            "activity": "Get Bc365 Token",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "policy": {
          "timeout": "0.00:10:00",
          "retry": 0,
          "retryIntervalInSeconds": 30,
          "secureOutput": false,
          "secureInput": true
        },
        "typeProperties": {
          "method": "GET",
          "headers": {
            "Authorization": {
              "value": "Bearer @{activity('Get Bc365 Token').output.access_token}",
              "type": "Expression"
            },
            "Accept": {
              "value": "application/json",
              "type": "Expression"
            },
            "Prefer": {
              "value": "odata.maxpagesize=1000",
              "type": "Expression"
            }
          },
          "relativeUrl": {
            "value": "@concat(\n    pipeline().libraryVariables.vl_Bc365_Bc365TenantId,'/',\n    pipeline().libraryVariables.vl_Bc365_Bc365UkEnvSandbox,'/',\n    'api','/',\n    pipeline().parameters.ApiPublisher,'/',\n    pipeline().parameters.ApiGroup,'/',\n    'v2.0','/',\n    'companies(',pipeline().parameters.CompanyId,')','/',\n    pipeline().parameters.ApiEntitySetName,\n    '?$filter=lastModifiedDateTime le ', formatDateTime(utcNow(), 'yyyy-MM-ddTHH:mm:ssZ'),\n    ' and maxPaymentTolerance gt 0',\n    '&$select=maxPaymentTolerance&$top=10'\n)\n",
            "type": "Expression"
          }
        },
        "externalReferences": {
          "connection": "c9d52d7a-b4d6-46bb-8671-ecad64ab916e"
        }
      },
      {
        "name": "SetFileName",
        "type": "SetVariable",
        "state": "Inactive",
        "onInactiveMarkAs": "Succeeded",
        "dependsOn": [
          {
            "activity": "Get Bc365 Token",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "policy": {
          "secureOutput": false,
          "secureInput": false
        },
        "typeProperties": {
          "variableName": "FileName",
          "value": {
            "value": "@concat(replace(replace(substring(utcnow(),8,11),':',''),'T','-'), '.parquet')",
            "type": "Expression"
          }
        }
      },
      {
        "name": "SetFolderPath",
