      {
        "type": "Lookup",
        "typeProperties": {
          "source": {
            "type": "FabricSqlDatabaseSource",
            "sqlReaderQuery": {
              "value": "WITH BatchedProcesses AS (\n    SELECT \n        P.ApiEndPoint,\n        /* Assigns a batch ID from 0 to N, grouping every 7 rows together */\n        BatchCount = (ROW_NUMBER() OVER (ORDER BY P.ApiEndPoint) - 1) / 7\n    FROM Meta.Process P \n    WHERE P.IsActive = 1 AND P.TableSchema = 'Kantata'\n)\nSELECT \n    ApiEndPoint = STRING_AGG(CONVERT(NVARCHAR(MAX), CONCAT(CHAR(39), ApiEndPoint, CHAR(39))), ', ')\nFROM BatchedProcesses\nGROUP BY BatchCount\nORDER BY BatchCount;",
              "type": "Expression"
            },
            "partitionOption": "None",
            "queryTimeout": "02:00:00"
          },
          "datasetSettings": {
            "type": "FabricSqlDatabaseTable",
            "schema": [],
            "connectionSettings": {
              "name": "61b1f767_45de_48d3_b2f1_feaeae53af39",
              "properties": {
